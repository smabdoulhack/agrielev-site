---
// En-tête des pages intérieures : texte à gauche, photo de terrain encadrée à droite,
// sillons en fond (signature). Variante compacte sans photo pour les pages de service.
import Photo from './Photo.astro';
import Icone from './Icone.astro';
import Sillons from './Sillons.astro';
import type { PhotoSite } from '../data/photos.ts';

interface Props {
  /** Pastille d'identité au-dessus du titre (courte, en casse normale). */
  surtitre?: string;
  titre: string;
  chapeau?: string;
  photo?: PhotoSite;
  /** Photo verticale : cadre plus haut. */
  portrait?: boolean;
  /** Étiquette posée en haut de la photo (lieu, date). */
  etiquette?: string;
  /** Panneau blanc posé en bas de la photo. */
  panneau?: { icone: string; titre: string; texte?: string };
  /** Variante courte, sans photo (blog, contact, pages légales). */
  compact?: boolean;
  ariane?: { libelle: string; href: string }[];
}
const { surtitre, titre, chapeau, photo, portrait = false, etiquette, panneau, compact = false, ariane } = Astro.props;
const avecPhoto = Boolean(photo) && !compact;
---
<section class:list={['entete-page', { 'entete-page--compact': compact, 'entete-page--photo': avecPhoto }]}>
  <div class:list={['conteneur', 'entete-page__grille', { 'disposition disposition--7-5': avecPhoto }]}>
    <div class="entete-page__texte">
      {ariane && (
        <nav class="ariane" aria-label="Fil d’Ariane">
          <ol>
            <li><a href="/">Accueil</a></li>
            {ariane.map((a) => <li><a href={a.href}>{a.libelle}</a></li>)}
          </ol>
        </nav>
      )}
      {surtitre && <p class="pastille-titre entete-page__identite"><span class="point point--or" aria-hidden="true"></span>{surtitre}</p>}
      <h1>{titre}</h1>
      {chapeau && <p class="chapeau">{chapeau}</p>}
      <slot />
    </div>
    {avecPhoto && photo && (
      <div class="entete-page__visuel">
        <Sillons classe="entete-page__sillons" fuite={0.6} rangs={22} />
        <div class:list={['photo-carte', { 'entete-page__photo--portrait': portrait }]}>
          <Photo photo={photo} prioritaire sizes="(min-width: 80rem) 32rem, (min-width: 64rem) 40vw, 100vw" />
          {etiquette && <div class="photo-carte__haut"><span class="etiquette etiquette--blanc etiquette--forte"><span class="point" aria-hidden="true"></span>{etiquette}</span></div>}
          {panneau && (
            <div class="photo-carte__bas">
              <span class="pastille pastille--moyenne"><Icone nom={panneau.icone} taille={22} /></span>
              <div>
                <strong>{panneau.titre}</strong>
                {panneau.texte && <p>{panneau.texte}</p>}
              </div>
            </div>
          )}
        </div>
      </div>
    )}
  </div>
  {compact && <Sillons classe="entete-page__sillons entete-page__sillons--compact" fuite={0.85} rangs={20} />}
</section>

<style>
  .entete-page { position: relative; overflow: hidden; padding: clamp(2rem, 1rem + 3.5vw, 4rem) 0 clamp(2.5rem, 1.5rem + 3.5vw, 4.5rem); background: linear-gradient(to bottom, rgb(233 243 234 / 0.85), var(--surface) 75%); }
  .entete-page__grille { position: relative; z-index: 1; row-gap: var(--esp-5); }
  .entete-page__texte { display: flex; flex-direction: column; gap: var(--esp-3); }
  .entete-page__texte > * { margin: 0; }
  .entete-page__texte :global(> .actions) { margin-top: var(--esp-2); }
  .entete-page__identite { text-transform: none; letter-spacing: 0; font-size: var(--fs-sm); background: #FFFFFF; }
  .entete-page h1 { max-width: 18ch; }
  .entete-page .chapeau { max-width: 38rem; }

  .entete-page__visuel { position: relative; }
  :global(.entete-page__sillons) { position: absolute !important; top: -3rem; bottom: -3rem; left: -3rem; right: calc(-1 * var(--gouttiere) - 3rem); width: auto !important; height: auto !important; color: var(--ae-sauge); opacity: 0.5; }
  .entete-page__visuel .photo-carte { --hauteur-photo: 20rem; --hauteur-photo-large: 26rem; }
  .entete-page__visuel .entete-page__photo--portrait { --hauteur-photo: 24rem; --hauteur-photo-large: 32rem; }
  @media (min-width: 64rem) { :global(.entete-page__sillons) { top: -5rem; left: -6rem; right: -40vw; } }

  .entete-page--compact { padding-bottom: clamp(2rem, 1.25rem + 2.5vw, 3.5rem); }
  .entete-page--compact h1 { max-width: 22ch; }
  :global(.entete-page__sillons--compact) { inset: 0 0 0 45% !important; z-index: 0; opacity: 0.4 !important; }
  @media (max-width: 47.99rem) { :global(.entete-page__sillons--compact) { display: none !important; } }

  .ariane ol { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; margin: 0; padding: 0; list-style: none; font-size: var(--fs-sm); color: var(--texte-doux); }
  .ariane li + li::before { content: '/'; margin-right: 0.5rem; color: var(--ae-sauge); }
  .ariane a { color: var(--texte-doux); text-decoration: none; }
  .ariane a:hover { color: var(--ae-vert-foret); text-decoration: underline; }
</style>
