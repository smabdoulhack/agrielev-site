---
import Icone from './Icone.astro';

interface Props {
  titre: string;
  url: string;
}
const { titre, url } = Astro.props;
const e = encodeURIComponent;
const liens = [
  { nom: 'WhatsApp', icone: 'whatsapp-logo', href: `https://wa.me/?text=${e(`${titre} ${url}`)}` },
  { nom: 'Facebook', icone: 'facebook-logo', href: `https://www.facebook.com/sharer/sharer.php?u=${e(url)}` },
  { nom: 'LinkedIn', icone: 'linkedin-logo', href: `https://www.linkedin.com/sharing/share-offsite/?url=${e(url)}` },
];
---
<div class="partage">
  <p class="partage__titre">Partager l’article</p>
  <ul class="liste-nue">
    {liens.map((l) => (
      <li><a href={l.href} target="_blank" rel="noopener" data-umami-event={`partage-${l.nom.toLowerCase()}`}>
        <Icone nom={l.icone} taille={20} /><span>{l.nom}</span><span class="visuellement-cache"> (nouvel onglet)</span>
      </a></li>
    ))}
    <li><button type="button" class="partage__copier" data-url={url}><Icone nom="link-simple" taille={20} /><span>Copier le lien</span></button></li>
  </ul>
  <p class="visuellement-cache" aria-live="polite" data-annonce></p>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.partage__copier').forEach((bouton) => {
    const texte = bouton.querySelector('span');
    const annonce = bouton.closest('.partage')?.querySelector<HTMLElement>('[data-annonce]');
    let minuterie: number | undefined;
    bouton.addEventListener('click', async () => {
      let message = 'Lien copié';
      try {
        await navigator.clipboard.writeText(bouton.dataset.url ?? location.href);
      } catch {
        message = 'Copie impossible';
      }
      if (texte) texte.textContent = message;
      if (annonce) annonce.textContent = message;
      window.clearTimeout(minuterie);
      minuterie = window.setTimeout(() => { if (texte) texte.textContent = 'Copier le lien'; if (annonce) annonce.textContent = ''; }, 3000);
    });
  });
</script>

<style>
  .partage { display: flex; flex-wrap: wrap; align-items: center; gap: var(--esp-3); }
  .partage__titre { margin: 0; font-family: var(--font-titre); font-weight: 700; color: var(--ae-vert-foret); }
  .partage ul { display: flex; flex-wrap: wrap; gap: var(--esp-2); }
  .partage a, .partage button {
    display: inline-flex; align-items: center; gap: 0.625rem; min-height: 2.75rem; padding: 0.4rem 1rem 0.4rem 0.5rem;
    border: 0; border-radius: var(--radius); background: #FFFFFF; box-shadow: var(--ombre-1);
    color: var(--ae-vert-foret); font: inherit; font-size: var(--fs-sm); font-weight: 600; text-decoration: none; cursor: pointer;
    transition: background-color var(--transition), box-shadow var(--transition), color var(--transition);
  }
  /* Petit carré d'icône, comme les pastilles du site. */
  .partage :is(a, button) :global(.icone) { box-sizing: content-box; padding: 0.375rem; border-radius: 8px; background: var(--ae-vert-brume); }
  .partage a:hover, .partage button:hover { background: var(--ae-vert-foret); color: #FFFFFF; box-shadow: var(--ombre-2); }
  .partage :is(a, button):hover :global(.icone) { background: rgb(255 255 255 / 0.15); }
</style>
