---
// Liste éditoriale du blog : filtres par rubrique, article à la une, grille des suivants,
// pagination, puis les rubriques du blog. Utilisée par /blog et /blog/categorie/….
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import CarteArticle from './CarteArticle.astro';
import Icone from './Icone.astro';
import Photo from './Photo.astro';
import { PHOTOS } from '../data/photos.ts';
import { CATEGORIES, type CategorieCode } from '../lib/blog.ts';
import { lienContact } from '../lib/sujets.ts';
import { RUBRIQUES } from '../pages/blog/_rubriques.ts';

interface Props {
  page: Page<CollectionEntry<'articles'>>;
  categorieActive?: CategorieCode;
  /** Nombre d'articles publiés par rubrique, et au total. */
  comptes: Record<CategorieCode, number> & { total: number };
}
const { page, categorieActive, comptes } = Astro.props;
const proposer = lienContact('autre', categorieActive ? `/blog/categorie/${categorieActive}` : '/blog');
const filtres = [
  { code: undefined, libelle: 'Tous les articles', href: '/blog', nombre: comptes.total },
  ...CATEGORIES.map((c) => ({ ...c, href: `/blog/categorie/${c.code}`, nombre: comptes[c.code] })),
];
const pluriel = (n: number) => `${n} article${n > 1 ? 's' : ''}`;

// Première page : l'article le plus récent est à la une, les suivants en grille.
const [premier, ...suivants] = page.data;
const avecUne = page.currentPage === 1 && Boolean(premier);
const grille = avecUne ? suivants : page.data;
// Une tuile « Proposer un sujet » complète la dernière rangée quand il y manque une case.
const derniere = page.currentPage === page.lastPage;
const avecTuile = derniere && grille.length > 0 && (grille.length % 3 === 2 || grille.length === 1);
const cases = grille.length + (avecTuile ? 1 : 0);
const colonnes = cases % 3 === 0 ? 'grille--3' : cases % 2 === 0 ? 'grille--2' : 'grille--3';
const autresRubriques = CATEGORIES.filter((c) => c.code !== categorieActive);
---
<section class="section section--serree liste-articles">
  <div class="conteneur">
    <nav class="filtres" aria-label="Catégories du blog">
      <ul class="liste-nue">
        {filtres.map((f) => (
          <li>
            <a href={f.href} aria-current={f.code === categorieActive ? 'page' : undefined}>
              {f.libelle}
              <span class="filtres__nombre" aria-hidden="true">{f.nombre}</span>
              <span class="visuellement-cache">({pluriel(f.nombre)})</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {page.data.length > 0 ? (
      <div class="articles">
        {avecUne && (
          <div class="une">
            <p class="une__repere"><span class="point point--or" aria-hidden="true"></span>À la une</p>
            <CarteArticle article={premier} une titreNiveau="h2" />
          </div>
        )}
        {grille.length > 0 && (
          <div class="suivants">
            {avecUne && <h2 class="titre-bloc suivants__titre">Articles précédents</h2>}
            <div class:list={['grille', 'grille--large', colonnes]}>
              {grille.map((a) => <CarteArticle article={a} titreNiveau={avecUne ? 'h3' : 'h2'} />)}
              {avecTuile && (
                <a class="tuile-sujet" href={proposer}>
                  <span class="pastille pastille--grande pastille--creme"><Icone nom="lightbulb" taille={24} /></span>
                  <strong>Un sujet à nous proposer ?</strong>
                  <span>Une question de terrain que vous aimeriez voir traitée dans le blog.</span>
                  <span class="lien-fleche">Proposer un sujet<Icone nom="arrow-right" taille={18} /></span>
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    ) : (
      <div class="vide">
        <span class="pastille pastille--grande"><Icone nom={categorieActive ? RUBRIQUES[categorieActive].icone : 'newspaper'} taille={26} /></span>
        <div class="vide__texte">
          <h2>{categorieActive ? 'Pas encore d’article dans cette catégorie' : 'Les premiers articles arrivent bientôt'}</h2>
          <p>{categorieActive ? 'Cette rubrique' : 'Le blog'} se remplira au fil de nos missions et de nos échanges avec les producteurs. Une question de terrain que vous aimeriez voir traitée ? Proposez-nous un sujet.</p>
          <div class="actions actions--serrees">
            {categorieActive && <a class="bouton bouton--foret" href="/blog">Voir tous les articles</a>}
            <a class="bouton bouton--fantome" href={proposer}><Icone nom="lightbulb" taille={20} />Proposer un sujet</a>
          </div>
        </div>
        <div class="vide__photo photo-carte">
          <Photo photo={categorieActive ? RUBRIQUES[categorieActive].photo : PHOTOS.terrainReunion} sizes="(min-width: 64rem) 26rem, 100vw" />
        </div>
      </div>
    )}

    {page.lastPage > 1 && (
      <nav class="pagination" aria-label="Pagination">
        {page.url.prev ? <a class="bouton bouton--secondaire" href={page.url.prev} rel="prev"><Icone nom="arrow-left" taille={18} />Articles plus récents</a> : <span></span>}
        <span class="pagination__etat">Page {page.currentPage} sur {page.lastPage}</span>
        {page.url.next ? <a class="bouton bouton--secondaire" href={page.url.next} rel="next">Articles plus anciens<Icone nom="arrow-right" taille={18} /></a> : <span></span>}
      </nav>
    )}
  </div>
</section>

<section class="section section--creme rubriques" aria-labelledby="rubriques-titre">
  <div class="conteneur disposition disposition--8-4 disposition--haut">
    <div>
      <h2 id="rubriques-titre" class="rubriques__titre">{categorieActive ? 'Les autres rubriques' : 'Les rubriques du blog'}</h2>
      <ul class:list={['liste-nue', 'grille', autresRubriques.length === 3 ? 'grille--3' : 'grille--2']}>
        {autresRubriques.map((c) => (
          <li class:list={['carte', 'carte--interactive', 'rubrique', { 'rubrique--vide': comptes[c.code] === 0 }]}>
            <div class="carte__haut">
              <span class="pastille pastille--moyenne"><Icone nom={RUBRIQUES[c.code].icone} taille={22} /></span>
              <span class:list={['etiquette', comptes[c.code] === 0 ? 'etiquette--neutre' : '']}>
                {comptes[c.code] === 0 ? 'Bientôt' : pluriel(comptes[c.code])}
              </span>
            </div>
            <h3><a class="lien-etendu" href={`/blog/categorie/${c.code}`}>{c.libelle}</a></h3>
            <p>{RUBRIQUES[c.code].texte}</p>
          </li>
        ))}
      </ul>
    </div>
    <aside class="sombre proposer" aria-labelledby="proposer-titre">
      <span class="pastille pastille--grande pastille--or"><Icone nom="lightbulb" taille={24} /></span>
      <h2 id="proposer-titre" class="proposer__titre">Une question de terrain ?</h2>
      <p>Dites-nous ce que vous aimeriez lire : un conseil technique, une filière, un retour d’expérience. Nous en tenons compte pour les prochains articles.</p>
      <a class="bouton bouton--principal" href={proposer}>Proposer un sujet<Icone nom="arrow-right" taille={20} /></a>
      <a class="proposer__rss" href="/rss.xml"><Icone nom="broadcast" taille={18} />Suivre le blog par flux RSS</a>
    </aside>
  </div>
</section>

<style>
  /* ---------- Filtres : une barre de rubriques, avec le nombre d'articles ---------- */
  .filtres { margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  .filtres ul {
    position: relative; display: flex; gap: 0.25rem; width: fit-content; max-width: 100%; padding: 0.25rem;
    border-radius: var(--radius); background: #FFFFFF; box-shadow: var(--ombre-1);
    overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none;
  }
  .filtres ul::-webkit-scrollbar { display: none; }
  @media (min-width: 40rem) { .filtres ul { flex-wrap: wrap; overflow: visible; } }
  .filtres li { flex: none; scroll-snap-align: start; }
  /* position: relative garde les libellés masqués dans la barre défilante (sinon la page déborde). */
  .filtres a {
    position: relative; display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0.4rem 0.9rem;
    border-radius: 9px; color: var(--ae-vert-foret); font-weight: 600; text-decoration: none; white-space: nowrap;
    transition: background-color var(--transition), color var(--transition);
  }
  .filtres a:hover { background: var(--ae-vert-brume); color: var(--ae-vert-foret); }
  .filtres a[aria-current='page'] { background: var(--ae-vert-foret); color: #FFFFFF; }
  .filtres__nombre {
    display: inline-grid; place-items: center; min-width: 1.5rem; height: 1.5rem; padding: 0 0.375rem; border-radius: 6px;
    background: var(--creme-douce); color: var(--ae-brun-terre); font-size: var(--fs-label-sm); font-weight: 700; font-variant-numeric: tabular-nums;
  }
  .filtres a[aria-current='page'] .filtres__nombre { background: rgb(255 255 255 / 0.18); color: #FFFFFF; }

  /* ---------- À la une et articles précédents ---------- */
  .articles { display: grid; gap: clamp(2.5rem, 2rem + 2vw, 4rem); }
  .une { display: grid; gap: var(--esp-3); }
  .une__repere { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0; font-family: var(--font-titre); font-weight: 700; color: var(--ae-vert-foret); }
  .une :global(.carte-article--une) { box-shadow: var(--ombre-3); }
  @media (min-width: 48rem) {
    .une :global(.carte-article--une .carte-article__media) { min-height: 24rem; }
    .une :global(.carte-article--une .carte-article__lire) { margin-top: var(--esp-2); }
    .une :global(.carte-article--une .carte-article__titre) { font-size: var(--fs-2xl); line-height: 1.12; letter-spacing: -0.025em; }
  }
  .suivants__titre { margin: 0 0 var(--esp-4); }

  .tuile-sujet {
    display: flex; flex-direction: column; justify-content: center; gap: var(--esp-2); min-height: 16rem;
    padding: var(--esp-4); border-radius: var(--radius); text-decoration: none; color: var(--texte-doux); font-size: var(--fs-sm);
    background: rgb(255 255 255 / 0.55); outline: 1.5px dashed color-mix(in srgb, var(--ae-sauge) 80%, var(--ae-vert-foret)); outline-offset: -1.5px;
    transition: background-color var(--transition);
  }
  .tuile-sujet:hover { background: #FFFFFF; color: var(--texte-doux); }
  .tuile-sujet strong { font-family: var(--font-titre); font-size: var(--fs-lg); color: var(--ae-vert-foret); }
  .tuile-sujet .lien-fleche { margin-top: var(--esp-2); }

  /* ---------- Rubrique vide : contour pointillé, comme ce qui est en préparation ---------- */
  .vide {
    display: flex; flex-direction: column; gap: var(--esp-4); align-items: flex-start;
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem); border-radius: var(--radius);
    background: rgb(255 255 255 / 0.6); outline: 1.5px dashed color-mix(in srgb, var(--ae-sauge) 80%, var(--ae-vert-foret)); outline-offset: -1.5px;
  }
  .vide__texte { flex: 1 1 22rem; max-width: 40rem; }
  .vide__photo { flex: none; width: 100%; --hauteur-photo: 12rem; --hauteur-photo-large: 15rem; box-shadow: var(--ombre-2); }
  .vide h2 { font-size: var(--fs-xl); margin: 0 0 var(--esp-2); }
  .vide p { margin: 0; color: var(--texte-doux); }
  @media (min-width: 64rem) {
    .vide { flex-direction: row; align-items: center; gap: var(--esp-5); }
    .vide__photo { flex: 0 1 26rem; }
  }

  .pagination { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--esp-3); margin-top: var(--esp-6); padding-top: var(--esp-4); border-top: 1px solid var(--ligne); }
  .pagination__etat { font-weight: 600; color: var(--texte-doux); font-variant-numeric: tabular-nums; }

  /* ---------- Rubriques ---------- */
  .rubriques__titre { margin: 0 0 var(--esp-4); font-size: var(--fs-xl); }
  @media (min-width: 64rem) {
    .rubriques__titre { font-size: var(--fs-2xl); }
    .rubriques .grille--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .rubriques .grille--2 { gap: var(--esp-3); }
  @media (min-width: 64rem) { .rubriques .grille--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .rubrique { padding: var(--esp-3); gap: var(--esp-2); }
  .rubrique h3 { margin-top: var(--esp-1); }
  @media (min-width: 48rem) { .rubrique { padding: var(--esp-4); } .rubrique h3 { margin-top: var(--esp-2); } }
  .rubrique h3 a { color: var(--ae-vert-foret); }
  .rubrique--vide { background: rgb(255 255 255 / 0.55); box-shadow: none; outline: 1.5px dashed color-mix(in srgb, var(--ae-sauge) 80%, var(--ae-vert-foret)); outline-offset: -1.5px; }

  .proposer {
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--esp-3);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); border-radius: var(--radius); box-shadow: var(--ombre-3);
  }
  .proposer > * { margin: 0; }
  .proposer__titre { font-size: var(--fs-xl); }
  .proposer p { color: var(--ae-vert-brume); }
  .proposer__rss { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: var(--esp-2); font-size: var(--fs-sm); font-weight: 600; color: #FFFFFF; }
  .proposer__rss:hover { color: var(--ae-or-recolte); }
  @media (min-width: 64rem) { .proposer { margin-top: calc(var(--fs-2xl) * 1.12 + var(--esp-4)); } }
</style>
