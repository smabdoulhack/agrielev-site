---
import { libelleStatut, type Statut } from '../lib/statut.ts';

interface Props {
  statut: Statut;
}
const { statut } = Astro.props;
---
<span class:list={['badge', `badge--${statut}`]}>
  <span class="badge__point" aria-hidden="true"></span>{libelleStatut(statut)}
</span>

<style>
  /* Étiquette à pastille de couleur, comme les statuts du site en ligne. */
  .badge {
    display: inline-flex; align-items: center; gap: 0.375rem; flex: none; width: fit-content;
    padding: 0.25rem 0.625rem; border-radius: var(--radius);
    font-family: var(--font-texte); font-size: var(--fs-label-sm); font-weight: 700; line-height: 1.35; white-space: nowrap;
    background: var(--ae-vert-brume); color: var(--ae-vert-foret);
  }
  .badge__point { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--cs-vert); }
  .badge--pilote { background: var(--cs-creme); color: var(--ae-brun-terre); }
  .badge--pilote .badge__point { background: var(--ae-or-recolte); }
  .badge--preparation { background: color-mix(in srgb, var(--ae-creme) 70%, #FFFFFF); color: var(--ae-brun-terre); font-weight: 600; }
  .badge--preparation .badge__point { background: var(--gris-ardoise); }
</style>
