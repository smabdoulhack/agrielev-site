---
// Modules de la plateforme, rangés par famille (ordre et couleurs de la charte).
// La forme dit le statut : en pilote, carte pleine à liseré or ; en préparation, contour pointillé.
import type { CollectionEntry } from 'astro:content';
import IconeModule from './IconeModule.astro';
import BadgeStatut from './BadgeStatut.astro';
import Icone from './Icone.astro';
import { FAMILLES, INFOS_FAMILLES, trierParFamille, type Famille } from '../lib/familles.ts';

interface Props {
  modules: CollectionEntry<'modules'>[];
  familles?: Famille[];
}
const { modules, familles = [...FAMILLES] } = Astro.props;
const tries = trierParFamille(modules.map((m) => ({ ...m.data, cle: m.id })));
const groupes = FAMILLES.filter((f) => familles.includes(f))
  .map((f) => ({ famille: f, items: tries.filter((m) => m.famille === f) }))
  .filter((g) => g.items.length > 0);
// Les modules qui ont déjà leur page.
const LIENS: Record<string, { href: string; libelle: string }> = { cuniculture: { href: '/cunismart', libelle: 'Voir CuniSmart' } };
---
<div class="modules">
  {groupes.map((g) => (
    <section
      class:list={['famille', `famille--${g.famille}`, `famille--${Math.min(g.items.length, 4)}`]}
      style={`--couleur-famille: var(${INFOS_FAMILLES[g.famille].couleur})`}
      aria-labelledby={`famille-${g.famille}`}
    >
      <header class="famille__haut">
        <h3 class="famille__titre" id={`famille-${g.famille}`}>{INFOS_FAMILLES[g.famille].libelle}</h3>
        <span class="famille__compte">{g.items.length} {g.items.length > 1 ? 'modules' : 'module'}</span>
      </header>
      <ul class="liste-nue famille__liste">
        {g.items.map((m) => (
          <li class:list={['module', `module--${m.statut}`]} data-test="module">
            <div class="module__haut">
              <IconeModule famille={m.famille} pictogramme={m.pictogramme} />
              <BadgeStatut statut={m.statut} />
            </div>
            <p class="module__nom">
              {LIENS[m.cle]
                ? <a class="lien-etendu" href={LIENS[m.cle].href}>AgriElev {m.nom}</a>
                : <span>AgriElev {m.nom}</span>}
            </p>
            <p class="module__description">{m.description}</p>
            {LIENS[m.cle] && <span class="module__suite" aria-hidden="true">{LIENS[m.cle].libelle}<Icone nom="arrow-right" taille={16} /></span>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  /* Mosaïque : chaque famille prend la largeur de ses modules (3 + 1, 1 + 2, puis 4). */
  .modules { display: grid; gap: var(--esp-3); }
  @media (min-width: 48rem) {
    .modules { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .famille--2, .famille--3, .famille--4 { grid-column: 1 / -1; }
  }
  @media (min-width: 64rem) {
    .modules { grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-flow: dense; gap: var(--gouttiere-colonnes); }
    .famille { grid-column: span 2; }
    .famille--2, .famille--3 { grid-column: span 4; }
    .famille--4 { grid-column: 1 / -1; }
  }

  .famille {
    display: flex; flex-direction: column; gap: var(--esp-3);
    padding: var(--esp-3); border-radius: var(--radius);
    background: color-mix(in srgb, var(--couleur-famille) 9%, #FFFFFF);
    box-shadow: inset 0 4px 0 var(--couleur-famille);
  }
  @media (min-width: 64rem) { .famille { padding: var(--esp-4); } }
  .famille__haut { display: flex; align-items: baseline; justify-content: space-between; gap: var(--esp-2); padding-top: var(--esp-1); }
  .famille__titre { margin: 0; font-size: var(--fs-lg); }
  .famille__compte { flex: none; font-size: var(--fs-label-sm); font-weight: 700; color: var(--texte-doux); font-variant-numeric: tabular-nums; }

  .famille__liste { display: grid; gap: var(--esp-2); flex: 1; }
  @media (min-width: 40rem) {
    .famille--2 .famille__liste, .famille--4 .famille__liste { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .famille--3 .famille__liste { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .famille--4 .famille__liste { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .module {
    position: relative; display: flex; flex-direction: column; gap: var(--esp-2);
    padding: var(--esp-3); border-radius: var(--radius);
  }
  .module > p { margin: 0; }
  .module--pilote, .module--disponible { background: #FFFFFF; box-shadow: var(--ombre-2), inset 0 3px 0 var(--ae-or-recolte); }
  .module--disponible { box-shadow: var(--ombre-2); }
  .module--preparation {
    background: rgb(255 255 255 / 0.6);
    outline: 1.5px dashed color-mix(in srgb, var(--couleur-famille) 55%, var(--ae-sauge)); outline-offset: -1.5px;
  }
  .module__haut { display: flex; align-items: center; justify-content: space-between; gap: var(--esp-2); }
  /* Petit écran : carte en ligne (pictogramme à gauche), plus courte. */
  @media (max-width: 39.99rem) {
    .module { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--esp-3); row-gap: 0.25rem; align-items: start; }
    .module__haut { display: contents; }
    .module__haut > :global(.icone-module) { grid-row: 1 / span 3; }
    .module__haut > :global(.badge) { grid-column: 2; grid-row: 3; }
    .module__nom { grid-column: 2; grid-row: 1; }
    .module__description { grid-column: 2; grid-row: 2; }
    .module__suite { grid-column: 2; grid-row: 4; }
  }
  .module__nom { font-family: var(--font-titre); font-weight: 700; font-size: var(--fs-lg); line-height: 1.3; color: var(--ae-vert-foret); }
  .module__nom a { color: inherit; }
  .module__description { font-size: var(--fs-sm); line-height: 1.45; color: var(--texte-doux); }
  .module__suite { display: inline-flex; align-items: center; gap: 0.3rem; margin-top: auto; font-size: var(--fs-sm); font-weight: 700; color: var(--ae-vert-foret); }
  .module:has(.lien-etendu) { transition: box-shadow var(--transition), transform var(--transition); }
  .module:has(.lien-etendu):hover { box-shadow: var(--ombre-3), inset 0 3px 0 var(--ae-or-recolte); }
  .module:has(.lien-etendu):hover .module__suite :global(.icone) { transform: translateX(3px); }
  .module:has(.lien-etendu:focus-visible) { outline: 3px solid var(--ae-vert-foret); outline-offset: 3px; }
  .module__suite :global(.icone) { transition: transform var(--transition); }
</style>
