---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnTetePage from '../components/EnTetePage.astro';
import BadgeStatut from '../components/BadgeStatut.astro';
import Icone from '../components/Icone.astro';
import BandeauContact from '../components/BandeauContact.astro';
import { PHOTOS } from '../data/photos.ts';
import { chargerVisibles } from '../lib/collections.ts';
import { formatDate } from '../lib/format.ts';

const etudes = (await chargerVisibles('etudes')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const formations = (await chargerVisibles('formations')).sort((a, b) => a.data.ordre - b.data.ordre);
const documents = (await chargerVisibles('documents')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const FORMATS = { video: 'Vidéo', audio: 'Audio', texte: 'Texte' } as const;
---
<BaseLayout titre="Terrain et ressources" description="Études de cas, parcours de formation et documents publics d'AgriElev.">
  <EnTetePage surtitre="Ressources" titre="Terrain et ressources" chapeau="Des réalisations documentées, des parcours de formation et des documents publics." photo={PHOTOS.ressources}>
    <nav class="actions" aria-label="Sections de la page">
      <a class="bouton bouton--secondaire" href="#etudes-de-cas">Études de cas</a>
      <a class="bouton bouton--secondaire" href="#formations">Formations</a>
      <a class="bouton bouton--secondaire" href="#documents">Documents</a>
      <a class="bouton bouton--secondaire" href="/blog">Lire le blog</a>
    </nav>
  </EnTetePage>

  <section id="etudes-de-cas" class="section">
    <div class="conteneur">
      <h2>Études de cas</h2>
      {etudes.length === 0 ? (
        <p class="vide">Les premières études de cas seront publiées dès que leurs résultats auront été vérifiés.</p>
      ) : (
        <div class="grille">
          {etudes.map((e) => (
            <article class="fiche">
              <h3>{e.data.titre}</h3>
              <p>{e.data.lieu}, {e.data.periode}. {e.data.population}.</p>
              <p><strong>{e.data.indicateur} :</strong> {e.data.resultat}</p>
              <p class="fiche__source">Source : {e.data.source}</p>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <section id="formations" class="section section--creme">
    <div class="conteneur">
      <h2>Formations CuniMaster</h2>
      {formations.length === 0 ? (
        <p class="vide">Les parcours de formation seront présentés ici une fois confirmés. <a href="/contact">Être informé</a></p>
      ) : (
        <ul class="grille liste-nue">
          {formations.map((f) => (
            <li class="fiche">
              <h3>{f.data.titre}</h3>
              <p>{f.data.filiere}</p>
              <BadgeStatut statut={f.data.statut} />
              {f.data.formats.length > 0 && <p>{f.data.formats.map((x) => FORMATS[x]).join(', ')}</p>}
              {f.data.langues.length > 0 && <p>Langues : {f.data.langues.join(', ')}</p>}
              {f.data.lien && <a href={f.data.lien}>Accéder au parcours</a>}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section id="documents" class="section">
    <div class="conteneur">
      <h2>Documents publics</h2>
      {documents.length === 0 ? (
        <p class="vide">Aucun document public pour le moment.</p>
      ) : (
        <ul class="liste-nue documents">
          {documents.map((d) => (
            <li><a href={d.data.fichier}><Icone nom="file-pdf" taille={24} /> {d.data.titre}</a> <span>({formatDate(d.data.date)})</span><p>{d.data.description}</p></li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <BandeauContact />
</BaseLayout>

<style>
  .liste-nue { list-style: none; margin: 0; padding: 0; }
  .fiche { padding: var(--esp-4); background: #FFFFFF; border-radius: var(--radius); border: 1px solid var(--ae-vert-brume); }
  .fiche__source { font-size: 0.9rem; color: var(--gris-ardoise); }
  .documents { display: grid; gap: var(--esp-4); }
  .documents a { display: inline-flex; align-items: center; gap: var(--esp-2); font-weight: 600; }
</style>
