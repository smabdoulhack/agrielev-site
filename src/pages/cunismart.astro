---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icone from '../components/Icone.astro';
import Photo from '../components/Photo.astro';
import Sillons from '../components/Sillons.astro';
import EcranApp from '../components/EcranApp.astro';
import BadgeStatut from '../components/BadgeStatut.astro';
import BoutonCuniSmart from '../components/BoutonCuniSmart.astro';
import BandeauContact from '../components/BandeauContact.astro';
import logoCuniSmart from '../assets/cunismart/logo-cunismart.webp';
import { SITE } from '../data/site.ts';
import { PHOTOS } from '../data/photos.ts';
import { CAPTURES, MENTION_CAPTURES } from '../data/captures.ts';
import { ESPECES, FAIT_POUR_ICI, METIERS, POUR_TOUS, SANS_RESEAU, STATUT_CUNISMART } from '../data/cunismart.ts';
import { lienContact } from '../lib/sujets.ts';
import { libelleStatut } from '../lib/statut.ts';
import { formatDate } from '../lib/format.ts';

const demo = lienContact('demo-cunismart', '/cunismart');
const statut = libelleStatut(STATUT_CUNISMART).toLowerCase();

// Habillage des métiers : couleur de la charte et repère tiré de la description.
const HABILLAGE: Record<string, { couleur: string; repere: string }> = {
  'Élevage': { couleur: '--mod-terracotta', repere: 'Une par une ou en bande' },
  Transformation: { couleur: '--ae-or-fonce', repere: 'De la collecte à la vente' },
  Cultures: { couleur: '--mod-vert-pousse', repere: 'Sacs et bassines convertis en kilos' },
  Aquaculture: { couleur: '--mod-bleu-lagune', repere: 'Bassin par bassin' },
  Recyclage: { couleur: '--cs-vert', repere: 'En lots pesés' },
};

// Espèces : pictogramme quand il existe, filière en toutes lettres.
const ESPECES_DETAIL: Record<string, { icone: string; filiere: string }> = {
  Lapins: { icone: 'rabbit', filiere: 'Cuniculture' },
  'Poules pondeuses': { icone: 'bird', filiere: 'Aviculture' },
  Porcs: { icone: 'paw-print', filiere: 'Élevage porcin' },
  'Chèvres': { icone: 'paw-print', filiere: 'Élevage caprin' },
  Bovins: { icone: 'cow', filiere: 'Élevage bovin' },
  Moutons: { icone: 'paw-print', filiere: 'Élevage ovin' },
};

const ETAPES_ICONES = ['device-mobile', 'wifi-slash', 'cloud-arrow-up'];
const ETAPES_ETATS = ['Saisie notée', 'Gardée sur le téléphone', 'Envoyée, sans doublon'];
const FAIT_ICONES = ['phone', 'eye', 'device-mobile', 'users-three'];

const GALERIE = [CAPTURES.soins, CAPTURES.cultures, CAPTURES.cunimaster];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CuniSmart',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, Android, iOS',
  url: SITE.urlSiteCuniSmart,
  publisher: { '@type': 'Organization', name: SITE.raisonSociale, url: SITE.url },
};
---
<BaseLayout titre="CuniSmart by AgriElev" description="CuniSmart by AgriElev : le cahier de l'exploitation sur le téléphone, même sans réseau. Élevage, transformation, cultures, aquaculture et recyclage. En pilote, gratuit pendant le pilote." jsonLd={jsonLd}>
  <!-- Ouverture : la marque, la promesse et les vrais écrans sur le dégradé CuniSmart. -->
  <section class="ouverture-cs">
    <div class="conteneur disposition disposition--6-6 ouverture-cs__grille">
      <div class="ouverture-cs__texte">
        <nav class="ariane" aria-label="Fil d’Ariane">
          <ol class="liste-nue"><li><a href="/">Accueil</a></li><li><a href="/solutions#gestion-numerique">Nos solutions</a></li></ol>
        </nav>
        <div class="marque-cs">
          <Image src={logoCuniSmart} alt="" width={72} height={72} densities={[1, 2]} loading="eager" class="marque-cs__logo" />
          <div>
            <h1>CuniSmart by AgriElev</h1>
            <p class="marque-cs__editeur">L’application de gestion d’{SITE.raisonSociale}</p>
          </div>
        </div>
        <p class="promesse">Votre cahier, sur votre téléphone. <span class="promesse__trait">Même sans réseau.</span></p>
        <p class="chapeau">Notez vos bêtes, vos ventes et vos récoltes au champ. Tout part quand le réseau revient. En français, avec votre numéro de téléphone, sans e-mail.</p>
        <div class="actions">
          <BoutonCuniSmart variante="grand" />
          <a class="bouton bouton--secondaire bouton--grand" href={demo}>Demander une démonstration</a>
        </div>
        <ul class="liste-nue statut-cs">
          <li><BadgeStatut statut={STATUT_CUNISMART} /></li>
          <li><Icone nom="calendar-check" taille={18} />Lancée le {formatDate(SITE.dateLancementCuniSmart)}</li>
          <li><Icone nom="seal-check" taille={18} />Gratuite pendant le pilote</li>
        </ul>
      </div>

      <figure class="scene">
        <div class="scene__fond" aria-hidden="true">
          <Sillons classe="scene__sillons" fuite={0.5} rangs={18} />
        </div>
        <div class="scene__ecrans">
          <EcranApp capture={CAPTURES.aFaire} largeur={230} classe="scene__ecran scene__ecran--arriere" />
          <EcranApp capture={CAPTURES.accueil} largeur={280} classe="scene__ecran scene__ecran--avant" prioritaire />
        </div>
        <p class="scene__bulle scene__bulle--haut"><Icone nom="clock" taille={18} />À faire : les soins en retard d’abord</p>
        <p class="scene__bulle scene__bulle--bas"><Icone nom="device-mobile" taille={18} />Vos activités en gros boutons</p>
        <figcaption class="scene__mention">{MENTION_CAPTURES}</figcaption>
      </figure>
    </div>

    <div class="conteneur">
      <ul class="liste-nue reperes-cs" aria-label="CuniSmart en bref">
        <li><span class="reperes-cs__valeur">{METIERS.length}</span><span>métiers dans un seul cahier</span></li>
        <li><span class="reperes-cs__valeur">{ESPECES.length}</span><span>espèces suivies en élevage</span></li>
        <li><span class="reperes-cs__valeur">{POUR_TOUS.length}</span><span>fonctions communes à tous les métiers</span></li>
        <li><span class="reperes-cs__valeur reperes-cs__valeur--icone"><Icone nom="device-mobile" taille={30} /></span><span>Android ou iPhone, dans le navigateur</span></li>
      </ul>
    </div>
  </section>

  <!-- Sans réseau : la séquence réelle, racontée en trois temps. -->
  <section id="sans-reseau" class="section sombre sans-reseau">
    <div class="conteneur">
      <header class="entete-section">
        <div>
          <h2>Le cahier ne demande pas de réseau. CuniSmart non plus.</h2>
          <p>Il faut Internet pour s’inscrire et se connecter la première fois. Ensuite, pour noter, non.</p>
        </div>
      </header>
      <ol class="liste-nue fil">
        {SANS_RESEAU.map((e, i) => (
          <li class:list={['fil__etape', `fil__etape--${i + 1}`]}>
            <span class="fil__noeud"><Icone nom={ETAPES_ICONES[i] ?? 'check-circle'} taille={26} /></span>
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
            {ETAPES_ETATS[i] && <span class="fil__etat"><Icone nom={i === SANS_RESEAU.length - 1 ? 'check-circle' : i === 1 ? 'clock' : 'notebook'} taille={16} />{ETAPES_ETATS[i]}</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Les métiers et les fonctions communes. -->
  <section id="metiers" class="section metiers-section">
    <div class="conteneur">
      <header class="entete-section">
        <div>
          <h2>Cinq métiers, un seul cahier</h2>
          <p>Chaque métier se compte dans son unité : des têtes, des litres, des sacs, des kilos. Vous ajoutez un métier quand vous voulez.</p>
        </div>
      </header>
      <ul class="liste-nue metiers">
        {METIERS.map((m) => (
          <li class="metier" data-test="fonction" style={`--couleur-metier: var(${HABILLAGE[m.nom]?.couleur ?? '--ae-vert-foret'})`}>
            <div class="metier__haut">
              <span class="metier__icone"><Icone nom={m.icone} taille={26} /></span>
              <BadgeStatut statut={m.statut} />
            </div>
            <h3>{m.nom}</h3>
            <p>{m.description}</p>
            {HABILLAGE[m.nom] && <p class="metier__repere">{HABILLAGE[m.nom].repere}</p>}
          </li>
        ))}
      </ul>

      <div class="pour-tous">
        <h3 class="titre-bloc">Et pour tous les métiers</h3>
        <ul class="liste-nue pour-tous__liste">
          {POUR_TOUS.map((f) => (
            <li class="fonction" data-test="fonction">
              <span class="pastille pastille--moyenne fonction__icone"><Icone nom={f.icone} taille={22} /></span>
              <div class="fonction__texte">
                <h4>{f.nom}</h4>
                <p>{f.description}</p>
              </div>
              <BadgeStatut statut={f.statut} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Espèces suivies en élevage. -->
  <section id="especes" class="section section--blanc section--serree especes-section">
    <div class="conteneur disposition disposition--4-8">
      <div class="empile">
        <h2 class="titre-bloc especes__titre">{ESPECES.length} espèces suivies en élevage</h2>
        <p class="texte-doux">Pour chacune, le suivi de l’élevage dans CuniSmart et un parcours de leçons dans CuniMaster. Toutes sont {statut}.</p>
      </div>
      <ul class="liste-nue especes">
        {ESPECES.map((e) => (
          <li class="espece">
            <span class="espece__icone"><Icone nom={ESPECES_DETAIL[e.nom]?.icone ?? 'paw-print'} taille={26} /></span>
            <span class="espece__nom">{e.nom}</span>
            <span class="espece__filiere">{ESPECES_DETAIL[e.nom]?.filiere}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Galerie des écrans réels, par public. -->
  <section id="captures" class="section section--creme galerie-section">
    <div class="conteneur">
      <header class="entete-section">
        <div>
          <h2>Ce que vous voyez sur le téléphone</h2>
          <p>{MENTION_CAPTURES}</p>
        </div>
      </header>

      <h3 class="galerie__groupe"><span class="galerie__pastille"><Icone nom="user" taille={18} /></span>Pour l’exploitant, au quotidien</h3>
      <div class="galerie" tabindex="0" role="region" aria-label="Écrans de l’exploitant (défilement horizontal sur petit écran)">
        {GALERIE.map((c, i) => (
          <div class="galerie__case">
            <span class="galerie__numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <EcranApp capture={c} largeur={250} legende classe="galerie__ecran" />
          </div>
        ))}
      </div>

      <h3 class="galerie__groupe" id="cooperatives-institutions"><span class="galerie__pastille"><Icone nom="users-three" taille={18} /></span>Pour la coopérative et le territoire</h3>
      <div class="publics">
        <article class="public">
          <div class="public__texte">
            <p class="public__qui">Coopératives</p>
            <h4 class="titre-bloc">Tenez les cahiers de vos producteurs</h4>
            <ul class="liste-coches">
              <li>Enregistrez les producteurs qui n’ont pas de téléphone et tenez leur cahier.</li>
              <li>Voyez ce qui est à vérifier (une récolte invraisemblable, plus de matière transformée que collectée) et confirmez-le.</li>
              <li>« Ma coopérative » : l’activité de tous les membres sur l’année, et qui saisit vraiment.</li>
            </ul>
            <a class="lien-fleche lien-fleche--vert" href="/cooperatives">L’accompagnement des coopératives<Icone nom="arrow-right" taille={18} /></a>
          </div>
          <div class="public__visuel"><EcranApp capture={CAPTURES.cooperative} largeur={240} legende classe="public__ecran" /></div>
        </article>
        <article class="public public--territoire">
          <div class="public__texte">
            <p class="public__qui">Mairies, directions, ministères</p>
            <h4 class="titre-bloc">Des chiffres par territoire, jamais une ferme nommée</h4>
            <ul class="liste-coches">
              <li>Cheptel, cultures, transformation et participation des producteurs, par commune, département et pays.</li>
              <li>Des exports pour Excel, qui disent leur périmètre et leur date.</li>
              <li>Un agent ne voit que des totaux, sur le seul territoire de son institution.</li>
            </ul>
            <a class="lien-fleche lien-fleche--vert" href={lienContact('institution', '/cunismart', 'partenaire')}>Présenter un projet institutionnel<Icone nom="arrow-right" taille={18} /></a>
          </div>
          <div class="public__visuel"><EcranApp capture={CAPTURES.territoire} largeur={240} legende classe="public__ecran" /></div>
        </article>
      </div>
    </div>
  </section>

  <!-- Fait pour ici : photo de terrain et quatre choix de conception. -->
  <section id="fait-pour-ici" class="section section--blanc">
    <div class="conteneur disposition disposition--5-7">
      <div class="photo-carte photo-carte--terre fait__photo">
        <Photo photo={PHOTOS.terrainReunion} position="50% 40%" sizes="(min-width: 80rem) 32rem, (min-width: 64rem) 40vw, 100vw" />
        <div class="photo-carte__bas">
          <span class="pastille pastille--grande pastille--creme"><Icone nom="users-three" taille={24} /></span>
          <div>
            <strong>Le technicien tient le cahier</strong>
            <p>Pour les membres de la coopérative qui n’ont pas de téléphone.</p>
          </div>
        </div>
      </div>
      <div class="empile fait__texte">
        <h2>Fait pour ici</h2>
        <p class="chapeau">Peu de réseau, des téléphones simples, le plein soleil : l’application part de ce que nous voyons sur le terrain.</p>
        <ol class="liste-nue fait">
          {FAIT_POUR_ICI.map((f, i) => (
            <li class="fait__item">
              <span class="fait__icone"><Icone nom={FAIT_ICONES[i] ?? 'check-circle'} taille={22} /></span>
              <div><h3>{f.titre}</h3><p>{f.texte}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Accès. -->
  <section id="acces" class="section section--creme">
    <div class="conteneur">
      <header class="entete-section entete-section--centre">
        <div>
          <h2>Trois façons d’utiliser CuniSmart</h2>
          <p>Seul, avec votre coopérative ou dans un projet de filière.</p>
        </div>
      </header>
      <div class="acces">
        <article class="carte carte--grande carte--pilote acces__carte">
          <span class="pastille pastille--grande pastille--creme"><Icone nom="user" taille={24} /></span>
          <h3>Accès individuel</h3>
          <p>Chaque éleveur ou éleveuse peut utiliser CuniSmart pour son exploitation. L’application est gratuite pendant le pilote.</p>
          <div class="carte__pied"><BoutonCuniSmart variante="moyen" /></div>
        </article>
        <article class="carte carte--grande carte--sombre acces__carte acces__phare">
          <span class="pastille pastille--grande pastille--or"><Icone nom="users-three" taille={24} /></span>
          <h3>Couverture collective</h3>
          <p>Pour les coopératives et organisations agricoles, AgriElev construit une formule adaptée au périmètre du projet. L’organisation définit ses priorités et mobilise une enveloppe pour les services convenus.</p>
          <div class="carte__pied"><a class="bouton bouton--principal" href="/cooperatives">Pour les coopératives<Icone nom="arrow-right" taille={20} /></a></div>
        </article>
        <article class="carte carte--grande acces__carte">
          <span class="pastille pastille--grande"><Icone nom="handshake" taille={24} /></span>
          <h3>Prestations de projet</h3>
          <p>Déploiement, formation et accompagnement de terrain pour un projet de filière, sur la base d’une proposition écrite.</p>
          <div class="carte__pied"><a class="lien-fleche lien-fleche--vert" href={lienContact('pilote-cooperative', '/cunismart')}>Présenter un projet<Icone nom="arrow-right" taille={18} /></a></div>
        </article>
      </div>
    </div>
  </section>

  <BandeauContact
    titre="Voir CuniSmart en action"
    texte="Nous vous présentons l’application sur votre propre exploitation ou avec votre coopérative."
    action={{ libelle: 'Organiser une démonstration', href: demo }}
  />
</BaseLayout>

<style>
  /* ---------- Ouverture : Crème CuniSmart, dégradé réservé à la scène des écrans ---------- */
  .ouverture-cs {
    position: relative; overflow: hidden; isolation: isolate;
    padding-block: clamp(1.75rem, 1rem + 3vw, 3.5rem) clamp(2.5rem, 2rem + 2vw, 3.5rem);
    background: linear-gradient(to bottom, var(--cs-creme), color-mix(in srgb, var(--cs-creme) 40%, var(--surface)) 80%);
  }
  .ouverture-cs__grille { align-items: center; row-gap: var(--esp-5); }
  .ouverture-cs__texte { display: flex; flex-direction: column; gap: var(--esp-4); }
  .ouverture-cs__texte > * { margin: 0; }
  .ariane ol { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; font-size: var(--fs-sm); }
  .ariane li + li::before { content: '/'; margin-right: 0.5rem; color: var(--cs-orange-brule); }
  .ariane a { color: var(--ae-brun-terre); text-decoration: none; }
  .ariane a:hover { text-decoration: underline; }

  .marque-cs { display: flex; align-items: center; gap: var(--esp-3); }
  .marque-cs :global(.marque-cs__logo) { width: 64px; height: 64px; border-radius: 16px; box-shadow: 0 8px 20px rgb(178 74 23 / 0.25); }
  .marque-cs h1 { margin: 0; font-size: var(--fs-xl); line-height: 1.15; letter-spacing: -0.02em; color: var(--ae-brun-terre); }
  .marque-cs__editeur { margin: 0.125rem 0 0; font-size: var(--fs-sm); font-weight: 600; color: var(--texte-doux); }

  .promesse {
    font-family: var(--font-titre); font-weight: 800; font-size: clamp(2.5rem, 1.5rem + 3.4vw, 4.25rem); line-height: 1.04; letter-spacing: -0.035em;
    color: var(--ae-vert-foret); max-width: 15ch; text-wrap: balance;
  }
  /* Trait de dégradé sous la fin de la promesse (le texte reste Vert Forêt). */
  .promesse__trait {
    background-image: var(--cs-degrade); background-repeat: no-repeat; background-size: 100% 0.16em; background-position: 0 94%;
    -webkit-box-decoration-break: clone; box-decoration-break: clone;
  }
  .ouverture-cs .chapeau { max-width: 34rem; color: var(--ae-brun-terre); }
  .ouverture-cs .actions { margin-top: 0; }
  .statut-cs { display: flex; flex-wrap: wrap; align-items: center; gap: var(--esp-2) var(--esp-4); font-size: var(--fs-sm); font-weight: 600; color: var(--ae-brun-terre); }
  .statut-cs li { display: inline-flex; align-items: center; gap: 0.375rem; }
  .statut-cs :global(.icone) { color: var(--cs-orange-brule); }

  /* Scène : deux écrans réels posés sur le dégradé, sillons crème. */
  .scene { position: relative; width: 100%; max-width: 36rem; margin: 0 auto; padding: var(--esp-4) 0 0; }
  @media (min-width: 64rem) { .scene { max-width: none; } }
  .scene__fond { position: absolute; inset: 14% 0 18%; z-index: 0; overflow: hidden; border-radius: var(--radius); background: var(--cs-degrade); box-shadow: 0 30px 60px -20px rgb(178 74 23 / 0.45); }
  :global(.scene__sillons) { position: absolute !important; inset: 0; color: var(--cs-creme); opacity: 0.35; }
  .scene__ecrans { position: relative; z-index: 1; display: flex; justify-content: center; align-items: flex-end; }
  :global(.scene__ecran) { position: relative; flex: none; }
  :global(.scene__ecran--avant) { z-index: 2; width: clamp(12rem, 9rem + 10vw, 17.5rem) !important; }
  :global(.scene__ecran--arriere) { z-index: 1; width: clamp(10rem, 7.5rem + 8vw, 14.5rem) !important; margin-right: -4.5rem; margin-bottom: 3rem; transform: rotate(-7deg); }
  .scene__bulle {
    position: absolute; z-index: 3; display: inline-flex; align-items: center; gap: 0.5rem; margin: 0;
    padding: 0.5rem 0.875rem; border-radius: var(--radius); background: rgb(255 255 255 / 0.95); box-shadow: var(--ombre-3);
    font-size: var(--fs-sm); font-weight: 700; color: var(--ae-brun-terre); white-space: nowrap;
  }
  .scene__bulle :global(.icone) { color: var(--cs-orange-brule); }
  .scene__bulle--haut { top: 20%; left: 0; }
  .scene__bulle--bas { bottom: 18%; right: 0; background: var(--ae-vert-foret); color: #FFFFFF; }
  .scene__bulle--bas :global(.icone) { color: var(--ae-or-recolte); }
  .scene__mention { position: relative; z-index: 1; margin-top: var(--esp-3); text-align: center; font-size: var(--fs-xs); color: var(--texte-doux); }
  @media (max-width: 30rem) {
    :global(.scene__ecran--arriere) { margin-right: -5.5rem; }
    .scene__bulle { font-size: var(--fs-label-sm); }
    .scene__bulle--haut { top: 10%; }
  }
  @media (min-width: 64rem) {
    .scene__bulle--haut { left: -1.5rem; }
    .scene__bulle--bas { right: -0.5rem; }
  }

  /* Repères : bandeau blanc sous l'ouverture. */
  .reperes-cs {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; overflow: hidden;
    margin-top: var(--esp-5); border-radius: var(--radius); background: var(--ligne); box-shadow: var(--ombre-2);
  }
  @media (min-width: 64rem) { .reperes-cs { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .reperes-cs li { display: flex; align-items: center; gap: var(--esp-3); padding: var(--esp-3) var(--esp-4); background: #FFFFFF; font-size: var(--fs-sm); font-weight: 600; line-height: 1.35; color: var(--ae-brun-terre); }
  .reperes-cs__valeur { flex: none; min-width: 2.25rem; font-family: var(--font-titre); font-weight: 800; font-size: var(--fs-2xl); line-height: 1; letter-spacing: -0.03em; color: var(--cs-orange-brule); font-variant-numeric: tabular-nums; }
  .reperes-cs__valeur--icone { display: inline-grid; place-items: center; }
  @media (max-width: 30rem) { .reperes-cs li { flex-direction: column; align-items: flex-start; gap: var(--esp-1); padding: var(--esp-3); } }

  /* ---------- Sans réseau ---------- */
  .sans-reseau { position: relative; overflow: hidden; isolation: isolate; }
  .sans-reseau .entete-section p { color: var(--ae-vert-brume); }
