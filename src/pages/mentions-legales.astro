---
import PageLegale from '../components/PageLegale.astro';
import { SITE } from '../data/site.ts';
---
<PageLegale titre="Mentions légales" chapeau={`L’éditeur, l’hébergeur et les droits attachés au site ${SITE.url.replace('https://', '')}.`}>
  <h2>Éditeur du site</h2>
  <dl class="identite">
    <div><dt>Raison sociale</dt><dd>{SITE.raisonSociale}, société à responsabilité limitée au capital de {SITE.capital}</dd></div>
    <div><dt>RCCM</dt><dd>{SITE.rccm}</dd></div>
    <div><dt>IFU</dt><dd>{SITE.ifu}</dd></div>
    <div><dt>Siège</dt><dd>{SITE.siege}</dd></div>
    <div><dt>Téléphone</dt><dd>{SITE.telephones.join(' ou ')}</dd></div>
    <div><dt>Adresse électronique</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
  </dl>
  <h2>Directeur de la publication</h2>
  <p>Thierry Kouembi, fondateur et gérant.</p>
  <h2>Hébergement</h2>
  <p>OVH SAS, 2 rue Kellermann, 59100 Roubaix, France. Le serveur du site est situé en France.</p>
  <h2>Propriété intellectuelle</h2>
  <p>Les textes, logos et photographies de ce site appartiennent à {SITE.raisonSociale} ou sont utilisés avec l’autorisation de leurs auteurs et des personnes photographiées. Toute reproduction demande une autorisation écrite.</p>
  <h2>CuniSmart</h2>
  <p>CuniSmart est une application éditée par {SITE.raisonSociale}. Son utilisation relève de ses propres conditions.</p>
</PageLegale>

<style>
  .identite { display: grid; gap: 0; margin: 0 0 1.2em; }
  .identite > div { display: grid; gap: 0.1rem 1.5rem; padding-block: 0.7rem; border-top: 1px solid var(--ligne); }
  @media (min-width: 40rem) { .identite > div { grid-template-columns: 12rem 1fr; } }
  .identite dt { font-weight: 600; color: var(--ae-vert-foret); }
  .identite dd { margin: 0; }
</style>
