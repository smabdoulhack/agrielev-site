# /srv/agrielev/.env sur le VPS (créé par deployer.sh, jamais versionné).
# Le mot de passe SMTP n'est pas ici : il est dans /srv/agrielev/secrets/smtp (droits 600).
SMTP_HOTE=smtp.hostinger.com
SMTP_PORT=465
SMTP_UTILISATEUR=hello@cunismart.com
EXPEDITEUR=hello@cunismart.com
DESTINATAIRE=hello@cunismart.com
# Branche du dépôt mise en ligne (les articles écrits dans /admin arrivent sur main).
BRANCHE=main
# Délai entre deux vérifications du dépôt, en secondes.
INTERVALLE=300
# 1 pour publier aussi l'article de test (src/content/articles/exemple-test.md).
ARTICLES_EXEMPLE=
